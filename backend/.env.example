# Copy to backend/.env for local use. Never commit real values.
# From repo root: docker compose --env-file backend/.env up --build
TIDAL_DB_PASSWORD=CHANGE_ME
TIDAL_DATABASE_URL=postgres://tidal:CHANGE_ME@tidal-db:5432/tidal?sslmode=disable
TIDAL_PUBLIC_ORIGIN=http://localhost:3000
TIDAL_ENV=development
TIDAL_LISTEN_ADDR=:8080
TIDAL_ADMIN_EMAIL=admin.example@example.invalid
# Optional password sign-in for the platform admin (12-128 chars). Leave empty to keep Google-only bootstrap.
TIDAL_ADMIN_PASSWORD=
# Set to 1 to overwrite an existing admin password from the environment on next start.
TIDAL_ADMIN_PASSWORD_RESET=
TIDAL_BREVO_API_KEY=
TIDAL_MAIL_FROM_EMAIL=admin@example.invalid
TIDAL_MAIL_FROM_NAME=Tidal
TIDAL_GOOGLE_CLIENT_ID=
TIDAL_GOOGLE_CLIENT_SECRET=
# Addresses allowed to set X-Forwarded-For (comma or space separated IPs or CIDRs). Loopback is always trusted.
# Production needs the public IPs/CIDRs of the reverse proxy in front of the backend.
# Anything malformed, including a catch-all 0.0.0.0/0, stops startup. Private ranges are accepted but only
# when listed explicitly: they are never trusted implicitly, and client-supplied forwarded entries on
# the left of the chain are never believed (the first untrusted address reading from the right wins).
# Without this list every request looks like it came from the proxy IP, so per-IP signup/login rate
# limits collapse into one shared bucket.
# TIDAL_TRUSTED_PROXIES=
# Shared secret for the signed client-IP headers the Vercel frontend sends (HMAC-SHA256 over
# "ip|unix-seconds"). Use the SAME value in the Vercel project env and here. Production requires at
# least 32 characters and refuses to start otherwise. Leave empty in development to disable signing.
# TIDAL_PROXY_SECRET=
